---
import Footer from '../components/Footer.astro'; 
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="A minimalist knowledge library for cloud, security, and AI execution notes."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col relative bg-white text-slate-800 antialiased">

		<slot /> 

		<Footer />

	</body>
</html>
