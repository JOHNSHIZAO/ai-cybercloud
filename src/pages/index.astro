---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Search from '../components/Search.astro'; 

const PREDEFINED_TAGS = ['Cloud Architecture', 'Security Governance', 'AI Integration', 'Zero Trust', 'DevSecOps', 'Automation'];

const posts = (await getCollection('blog'))
  .map((post) => {
    const publishDate = post.data.pubDate ?? post.data.date ?? new Date(0);
    const category = post.data.category ?? 'Cloud';
    const tags = post.data.tags ?? [];

    // 🤖 首圖自動尋標邏輯 (加入 typeof 防呆，徹底解決 Build Error)
    let thumbImage = post.data.image;
    if (!thumbImage || thumbImage.includes('[Insert image') || thumbImage.trim() === '') {
      const match = typeof post.body === 'string' ? post.body.match(/!\[.*?\]\((https?:\/\/[^\s)]+)\)/) : null;
      thumbImage = match ? match[1] : undefined;
    }

    return {
      ...post,
      publishDate,
      category,
      tags,
      thumbImage,
      href: `/blog/${post.id}/`,
    };
  })
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());

const assetCounts = posts.reduce<Record<string, number>>((counts, post) => {
  counts[post.category] = (counts[post.category] ?? 0) + 1;
  return counts;
}, {});

const dashboardItems = Object.entries(assetCounts).sort(([a], [b]) => a.localeCompare(b));
const initialLimit = 30;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  }).format(date);
---

<Layout title="Ai CyberCloud | Trust & Experience Architect">
  <div class="fixed inset-0 z-[-1] bg-slate-50 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
  
  <main class="mx-auto min-h-screen max-w-3xl px-6 py-12 sm:px-8">
    
    <header class="mb-10 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-800 p-8 sm:p-10 shadow-2xl shadow-blue-900/10 text-white relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"></div>
      
      <div class="relative z-10 flex items-center gap-5 mb-6">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400 to-blue-600 shadow-lg shadow-cyan-500/30 shrink-0">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-blue-400 sm:text-4xl">
            Ai CyberCloud
          </h1>
          <p class="text-sm font-medium text-cyan-400 mt-1">Trust & Experience Architect</p>
        </div>
      </div>
      
      <p class="max-w-xl text-sm leading-relaxed text-slate-300 relative z-10">
        Deconstructing complex security risks into seamless human experiences. Curating field-tested knowledge across cloud architecture, security governance, and AI-enabled delivery to build impenetrable trust.
      </p>

      <section class="mt-8 flex flex-wrap gap-3 text-xs relative z-10" aria-label="Asset overview">
        {dashboardItems.length > 0 ? (
          dashboardItems.map(([category, count]) => (
            <button 
              class="global-tag-btn rounded-full border border-slate-700 bg-slate-800/80 px-4 py-1.5 backdrop-blur-md transition hover:border-cyan-500 hover:bg-slate-700 cursor-pointer flex items-center"
              data-tag={category}
            >
              <span class="font-semibold text-cyan-400">{category}</span> 
              <span class="text-slate-400 ml-1">({count})</span>
            </button>
          ))
        ) : (
          <span class="text-slate-400">Initializing framework...</span>
        )}
      </section>
    </header>

    <section class="mb-6 flex flex-wrap gap-2">
      {PREDEFINED_TAGS.map(tag => (
        <button 
          class="global-tag-btn rounded-md bg-white border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition-all hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 active:scale-95 shadow-sm"
          data-tag={tag}
        >
          {tag}
        </button>
      ))}
    </section>

    <div id="search-active-header" class="hidden mb-6 flex flex-col sm:flex-row sm:items-center justify-between bg-gradient-to-r from-blue-50 to-slate-50 p-4 rounded-2xl border border-blue-100 shadow-sm gap-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-blue-600 shadow-inner">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
        <div>
          <h2 class="text-sm font-bold text-slate-800">Search Mode Active</h2>
          <p class="text-xs text-slate-500">Exploring knowledge nodes</p>
        </div>
      </div>
      <button id="btn-back-home" class="flex items-center justify-center gap-2 px-5 py-2 text-sm font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20 transition-all active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Home
      </button>
    </div>

    <div class="mb-10 bg-white p-2 rounded-xl shadow-sm border border-gray-100">
      <Search />
    </div>

    <section id="default-timeline" aria-labelledby="timeline-title" class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-gray-100 pb-4">
        <h2 id="timeline-title" class="text-xl font-bold text-slate-800">Unified Timeline</h2>
        <p id="result-count" class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">{posts.length} nodes</p>
      </div>

      <div id="timeline-list" class="divide-y divide-gray-100">
        {
          posts.map((post, index) => (
            <article class:list={['post-row flex flex-col sm:flex-row gap-5 sm:gap-8 items-start py-8 group transition-all', { hidden: index >= initialLimit }]}>
              
              <div class="w-full sm:w-48 shrink-0 flex flex-col gap-3">
                <a href={post.href} class="block w-full aspect-video bg-slate-50 rounded-xl overflow-hidden border border-slate-100 shadow-sm transition-transform group-hover:-translate-y-1 group-hover:shadow-md flex items-center justify-center relative">
                  {post.thumbImage ? (
                    <img src={post.thumbImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-contain p-1" />
                  ) : (
                    <span class="text-slate-300 text-[10px] font-mono tracking-widest uppercase">No Image</span>
                  )}
                </a>
                <time datetime={post.publishDate.toISOString()} class="text-sm font-medium text-slate-400 px-1 text-center sm:text-left group-hover:text-blue-500 transition-colors">
                  {formatDate(post.publishDate)}
                </time>
              </div>

              <div class="flex-1 flex flex-col gap-3 min-w-0 pt-1">
                <a href={post.href} class="block">
                  <h3 class="text-xl font-bold text-slate-800 leading-snug group-hover:text-blue-600 transition-colors">
                    {post.data.title}
                  </h3>
                </a>
                <div class="flex flex-wrap items-center gap-2 mt-1">
                  <span class="rounded-md bg-gradient-to-r from-blue-50 to-cyan-50 border border-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">
                    {post.category}
                  </span>
                  {post.tags.map((tag) => (
                    <span class="rounded-md bg-slate-50 border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-500">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {posts.length > initialLimit && (
        <div class="mt-10 text-center border-t border-gray-100 pt-10">
          <button id="load-more" type="button" class="rounded-xl border-2 border-slate-200 px-6 py-2.5 text-sm font-bold text-slate-600 transition-all hover:border-blue-600 hover:text-blue-600 hover:shadow-lg hover:shadow-blue-600/20 active:scale-95" data-limit={initialLimit}>
            Load More Nodes
          </button>
        </div>
      )}
    </section>
  </main>

  <script>
    const rows = Array.from(document.querySelectorAll('.post-row'));
    const loadMoreButton = document.querySelector<HTMLButtonElement>('#load-more');
    const pageSize = Number(loadMoreButton?.dataset.limit ?? 30);
    let visibleLimit = pageSize;

    loadMoreButton?.addEventListener('click', () => {
      visibleLimit += pageSize;
      rows.forEach((row, index) => {
        if (index < visibleLimit) row.classList.remove('hidden');
      });
      if (visibleLimit >= rows.length) loadMoreButton.classList.add('hidden');
    });

    window.addEventListener('DOMContentLoaded', () => {
      const defaultTimeline = document.getElementById('default-timeline');
      const searchHeader = document.getElementById('search-active-header');
      const btnBackHome = document.getElementById('btn-back-home');
      const tagButtons = document.querySelectorAll('.global-tag-btn');
      
      const checkSearchInput = setInterval(() => {
        const searchInput = document.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
        
        if (searchInput && defaultTimeline) {
          clearInterval(checkSearchInput);
          
          // ✅ 核心切換邏輯：控制首頁與搜尋狀態的切換
          const toggleSearchMode = (isActive: boolean) => {
            if (isActive) {
              defaultTimeline.style.display = 'none';
              searchHeader?.classList.remove('hidden');
            } else {
              defaultTimeline.style.display = 'block';
              searchHeader?.classList.add('hidden');
              searchInput.value = '';
              searchInput.dispatchEvent(new Event('input', { bubbles: true }));
              
              // 觸發 Pagefind 原生的清除按鈕
              const clearBtn = document.querySelector('.pagefind-ui__search-clear') as HTMLButtonElement;
              if (clearBtn) clearBtn.click();
            }
          };

          searchInput.addEventListener('input', (e) => {
            toggleSearchMode((e.target as HTMLInputElement).value.trim().length > 0);
          });

          tagButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
              const tagValue = (e.currentTarget as HTMLButtonElement).dataset.tag;
              if (tagValue && searchInput) {
                searchInput.value = tagValue;
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
                toggleSearchMode(true);
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }
            });
          });

          // 綁定「返回首頁」按鈕
          btnBackHome?.addEventListener('click', () => toggleSearchMode(false));

          // 監聽使用者點擊原生 "Clear" 時，自動返回首頁
          document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target && target.classList && target.classList.contains('pagefind-ui__search-clear')) {
              toggleSearchMode(false);
            }
          });
        }
      }, 300);
    });
  </script>
</Layout>
