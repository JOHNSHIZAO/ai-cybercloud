🔍 **抓到問題核心了：推薦區塊的資料層缺乏「尋標邏輯」**

因為我們在上一階段只有幫首頁 (`index.astro`) 寫了自動尋找圖片的 Regex（正則表達式）程式碼，但文章內頁 (`src/pages/blog/[...slug].astro`) 的延伸閱讀區塊，當時還是使用預設的純色漸層卡片，並沒有將「自動抓圖」的邏輯同步過來。

我已經把**自動化抓圖邏輯**與**影像呈現容器 (包含 16:9 比例與 object-contain 防裁切)** 完全移植到這份檔案中了。同時也將圖片區塊加上了超連結，現在讀者點擊縮圖也能直接跳轉！

請直接複製以下完整程式碼，100% 覆寫你的 **`src/pages/blog/[...slug].astro`** 檔案：

```astro
---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 智慧推薦演算法：依據分類與標籤計算關聯度權重
const allPosts = await getCollection('blog');
const otherPosts = allPosts.filter(p => p.id !== post.id);

const scoredPosts = otherPosts.map(p => {
  let score = 0;
  if (p.data.category === post.data.category) score += 5;
  
  const postTags = post.data.tags ?? [];
  const currentTags = p.data.tags ?? [];
  const sharedTags = currentTags.filter(t => postTags.includes(t));
  score += sharedTags.length * 2;
  
  // 🤖 新增：為推薦文章啟動「自動首圖尋標」邏輯
  let thumbImage = p.data.image;
  if (!thumbImage || thumbImage.includes('[Insert image') || thumbImage.trim() === '') {
    const match = p.body?.match(/!\[.*?\]\((.*?)\)/);
    thumbImage = match ? match[1] : undefined;
  }
  
  return { post: { ...p, thumbImage }, score };
});

const recommendedPosts = scoredPosts
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    const dateA = a.post.data.pubDate ?? a.post.data.date ?? new Date(0);
    const dateB = b.post.data.pubDate ?? b.post.data.date ?? new Date(0);
    return dateB.getTime() - dateA.getTime();
  })
  .map(item => item.post)
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  }).format(date);
---

<Layout title={`${post.data.title} | Ai CyberCloud`}>
  <div class="fixed inset-0 z-[-1] bg-slate-50 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
  
  <main class="max-w-3xl mx-auto px-6 py-16 sm:px-8 sm:py-24 relative">
    
    <div class="bg-white rounded-3xl p-8 sm:p-14 shadow-sm border border-gray-100">
      <header class="mb-14 border-b border-gray-100 pb-10">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl mb-6 leading-tight">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-3 text-sm text-slate-500">
          <time datetime={post.data.pubDate?.toISOString()}>
            {formatDate(post.data.pubDate ?? new Date())}
          </time>
          <span>·</span>
          <span class="rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
            {post.data.category}
          </span>
        </div>
      </header>

      <article class="custom-prose prose prose-slate prose-lg max-w-none hover:prose-a:text-blue-600 prose-a:transition-colors prose-headings:font-bold prose-img:rounded-2xl">
        <Content />
      </article>
    </div>

    <section class="mt-16 bg-white rounded-3xl p-8 shadow-sm border border-gray-100" aria-labelledby="recommended-title">
      <div class="mb-8">
        <div class="flex items-center gap-2 text-blue-600 text-sm font-semibold tracking-wider uppercase mb-1">
          <span class="h-2 w-2 rounded-full bg-blue-600"></span> Recommended
        </div>
        <h2 id="recommended-title" class="text-2xl font-bold text-slate-900">You Might Also Like</h2>
        <p class="text-sm text-slate-500 mt-1">Curated nodes for further exploration</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recommendedPosts.map((rPost) => (
          <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md group">
            
            <!-- ✅ 升級：縮圖容器，加入條件渲染與圖片超連結 -->
            <a href={`/blog/${rPost.id}/`} class="mb-4 aspect-[3/2] w-full rounded-xl bg-slate-50 relative overflow-hidden shrink-0 block border border-slate-100">
              {rPost.thumbImage ? (
                <img 
                  src={rPost.thumbImage} 
                  alt={rPost.data.title} 
                  class="absolute inset-0 w-full h-full object-contain p-1 transition-transform duration-300 group-hover:scale-105" 
                />
              ) : (
                <!-- 缺省狀態 -->
                <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-800 p-4 flex flex-col justify-between">
                  <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-blue-500/10 rounded-full filter blur-xl"></div>
                  <div class="mt-auto text-white/20 font-mono text-xs select-none">Ai_CyberCloud_Node</div>
                </div>
              )}
              <!-- 懸浮在圖片左上角的分類標籤 -->
              <span class="absolute top-3 left-3 rounded bg-white/90 shadow-sm px-2.5 py-0.5 text-[10px] font-semibold tracking-wide text-blue-600 backdrop-blur-md uppercase z-10">
                {rPost.data.category}
              </span>
            </a>
            
            <time class="text-xs font-medium text-slate-400">
              {formatDate(rPost.data.pubDate ?? new Date())}
            </time>
            
            <h3 class="mt-2 text-base font-bold text-slate-800 line-clamp-2 group-hover:text-blue-600 transition-colors min-h-[3rem]">
              <a href={`/blog/${rPost.id}/`}>
                {rPost.data.title.replace(/[\u2700-\u27BF]|[\uE000-\uF8FF]|\uD83C[\uDC00-\uDFFF]|\uD83D[\uDC00-\uDFFF]|[\u2011-\u26FF]|\uD83E[\uDD00-\uDFFF]/g, '')}
              </a>
            </h3>
            
            <p class="mt-2 text-xs text-slate-500 line-clamp-2 flex-1">
              {rPost.data.description}
            </p>
            
            <a href={`/blog/${rPost.id}/`} class="mt-4 flex items-center gap-1.5 text-xs font-bold text-blue-600 group-hover:underline">
              » Read Article
            </a>
          </div>
        ))}
      </div>
    </section>

    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2.5 sm:bottom-8 sm:right-8" id="floating-toolkit">
      <a href="/" title="Back to Home" class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-lg transition-all hover:border-blue-600 hover:text-blue-600 hover:scale-105 active:scale-95">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      </a>
      <button id="btn-to-top" title="Scroll to Top" class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-lg transition-all hover:border-blue-600 hover:text-blue-600 hover:scale-105 active:scale-95">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
      </button>
      <button id="btn-to-bottom" title="Scroll to Bottom" class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-lg transition-all hover:border-blue-600 hover:text-blue-600 hover:scale-105 active:scale-95">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <button id="btn-share" title="Share Post" class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-xl shadow-blue-600/20 transition-all hover:opacity-90 hover:scale-105 active:scale-95">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 8l6 6-6 6M21 14H11a6 6 0 0 0-6 6v1" />
        </svg>
      </button>
    </div>
  </main>

  <script>
    const topBtn = document.getElementById('btn-to-top');
    const bottomBtn = document.getElementById('btn-to-bottom');
    const shareBtn = document.getElementById('btn-share');

    topBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    bottomBtn?.addEventListener('click', () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));

    shareBtn?.addEventListener('click', async () => {
      const shareData = { title: document.title, url: window.location.href };
      try {
        if (navigator.share) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('🚀 Link copied to clipboard! Ready to share.');
        }
      } catch (err) {
        console.log('Share action captured', err);
      }
    });
  </script>
</Layout>

