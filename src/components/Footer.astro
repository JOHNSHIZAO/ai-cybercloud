    </div>

  </div>
  
  <div class="mx-auto max-w-3xl px-6 sm:px-8 mt-6 pt-6 border-t border-slate-100/50 text-center select-none">
    <p class="text-[10px] font-mono tracking-widest text-slate-400 uppercase">
      &copy; {currentYear} Ai CyberCloud. Framework established.
    </p>
  </div>
</footer>
