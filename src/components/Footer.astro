---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-slate-100 bg-white/80 backdrop-blur-md mt-auto py-10">
  <div class="mx-auto max-w-3xl px-6 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    
    <div class="flex flex-col items-center sm:items-start gap-1 select-none">
      <span class="text-sm font-bold text-slate-800 tracking-wide">張時造 ZHANG SHI ZAO</span>
      <span class="text-[11px] text-slate-400 font-mono font-medium uppercase tracking-wider">Trust & Experience Architect</span>
    </div>

    <div class="flex items-center gap-4">
      <a 
        href="mailto:f31823601@gmail.com" 
        title="Send Email for Business Cooperation" 
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:border-blue-600 hover:text-blue-600 hover:scale-105 active:scale-95"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5A2.25 2.25 0 012.25 17.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </a>

      <a 
        href="https://linkedin.com/in/%e5%bc%b5%e6%99%82%e9%80%a0mayer" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Connect on LinkedIn" 
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition-all hover:border-blue-600 hover:text-blue-600 hover:scale-105 active:scale-95"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
